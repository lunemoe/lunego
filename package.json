{
  "name": "lunego",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "pnpm --filter @lunego/eslint-plugin build && eslint .",
    "depcruise": "depcruise . --config .dependency-cruiser.cjs",
    "typecheck": "tsc -p packages/core/tsconfig.types.json && tsc -p templates/game/tsconfig.json --noEmit && tsc -p templates/game/tsconfig.logic.json --noEmit",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm depcruise && pnpm test && pnpm gen:check && pnpm test:e2e",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "test:e2e": "playwright test",
    "gen:check": "node packages/cli/dist/cli.js gen --check --cwd templates/game",
    "bench": "pnpm build && node bench/run.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@lunego/eslint-plugin": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
