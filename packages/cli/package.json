{
  "name": "lunego",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "templates"],
  "bin": {
    "lunego": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-templates.mjs",
    "pretest": "pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@lunego/eslint-plugin": "workspace:*",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
