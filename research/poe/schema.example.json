  "stat_catalog": [
    { "key": "life_flat", "unit": "integer", "stack_mode": "flat", "applies_to": "self" },
    { "key": "life_increased_pct", "unit": "percent", "stack_mode": "increased", "applies_to": "self" },
    { "key": "armour_flat_local", "unit": "integer", "stack_mode": "flat", "applies_to": "item_base" },
    { "key": "armour_increased_pct_local", "unit": "percent", "stack_mode": "increased", "applies_to": "item_base" },
    { "key": "fire_resistance_pct", "unit": "percent", "stack_mode": "flat", "applies_to": "self", "cap": 75 },
    { "key": "fire_max_resistance_pct", "unit": "percent", "stack_mode": "flat", "applies_to": "cap" },
    { "key": "added_fire_damage_attack", "unit": "integer_pair", "stack_mode": "flat", "applies_to": "damage" },
    { "key": "physical_damage_increased_pct", "unit": "percent", "stack_mode": "increased", "applies_to": "damage" },
    { "key": "movement_speed_increased_pct", "unit": "percent", "stack_mode": "increased", "applies_to": "self" },
    { "key": "crit_chance_increased_pct", "unit": "percent", "stack_mode": "increased", "applies_to": "damage" }
  ],
  "aggregation": {
    "pipeline": [
      "base = base_type_value(ilvl)",
      "flat = base + sum(flat_adds)",
      "increased = 1 + sum(increased_pct)/100",
      "more = product(1 + more_i/100)",
      "final = floor(flat * increased * more + 0.5)"
    ],
    "rules": [
      "local_* modifiers are folded into the item's own base value and never stack with global increases into a single pool",
      "increased sources of the same scope add; more sources always multiply",
      "speed uses rate = 1000/attack_time_ms so percentage multipliers apply to the rate",
      "resistance is clamped to cap after flat additions; max-resistance raises the cap first"
    ],
    "worked_examples": [
      {
        "target": "armour",
        "base": 320,
        "flat_add": 120,
        "local_increased_pct": 45,
        "quality_increased_pct": 2,
        "result": 647,
        "calc": "floor((320+120) * (1 + 0.45 + 0.02) + 0.5)"
      },
      {
        "target": "physical_damage",
        "base": [10, 20],
        "added_flat": [5, 9],
        "increased_pct": 60,
        "more_pct": 20,
        "result": [29, 56],
        "calc": "floor((10+5)*1.6*1.2+0.5) .. floor((20+9)*1.6*1.2+0.5)"
      }
    ]
  },
  "skill": {
